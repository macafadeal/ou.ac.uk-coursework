# ============================================================================
# .gitignore - Comprehensive Development Environment
# ============================================================================
# Covers: Node.js, Yarn, ESLint, Python, Jupyter Notebooks, and IDE configs
# ============================================================================

# ============================================================================
# 1. NODE.JS & NPM
# ============================================================================

# Dependencies
node_modules/
package-lock.json
npm-debug.log*
npm-error.log*
yarn-error.log*
lerna-debug.log*

# NPM package lock variations
.npm
.eslintcache

# Optional npm cache directory
.npm/

# Optional eslint cache
.eslintcache

# Bundles produced by bundlers
dist/
build/

# ============================================================================
# 2. YARN
# ============================================================================

# Yarn package manager
yarn.lock
.yarn/cache
.yarn/install-state.gz
.yarn/build-state.yml
.yarn/unplugged/

# Yarn Berry (modern Yarn) specific
.yarn
!.yarn/cache
!.yarn/releases
!.yarn/plugins
!.yarn/sdks
!.yarn/versions

# ============================================================================
# 3. ESLINT
# ============================================================================

.eslintcache
.eslintignore

# ============================================================================
# 4. PYTHON
# ============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/

# Translations
*.mo
*.pot

# Django stuff:
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal

# Flask stuff:
instance/
.webassets-cache

# Scrapy stuff:
.scrapy

# Sphinx documentation
docs/_build/

# PyBuilder
target/

# Jupyter Notebook
# .ipynb_checkpoints/
# *.ipynb

# IPython
profile_default/
ipython_config.py

# pyenv
.python-version

# pipenv
Pipfile.lock

# PEP 582
__pypackages__/

# Celery stuff
celerybeat-schedule
celerybeat.pid

# SageMath parsed files
*.sage.py

# Environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Spyder project settings
.spyderproject
.spyproject

# Rope project settings
.ropeproject

# mkdocs documentation
/site

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Pyre type checker
.pyre/

# ============================================================================
# 5. JUPYTER NOTEBOOKS
# ============================================================================

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Jupyter Lab
.jupyterlab-settings/
.jupyter/

# IPython
profile_default/
ipython_config.py

# ============================================================================
# 6. EDITOR & IDE CONFIGURATION
# ============================================================================

# VS Code
.vscode/
*.code-workspace
.history/

# JetBrains IDEs
.idea/
.idea_modules/
*.iml
*.iws
*.ipr

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*~
.swp
.swo
*.swp
*.swo
.vim/

# Emacs
*~
\#*\#
.\#*

# macOS
.DS_Store
.AppleDouble
.LSOverride

# ============================================================================
# 7. OS & SYSTEM FILES
# ============================================================================

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Linux
.directory

# ============================================================================
# 8. ENVIRONMENT & SECRETS
# ============================================================================

# Environment variables
.env
.env.local
.env.*.local

# Secrets & credentials
.aws/
.ssh/
*.pem
*.key
.tokens

# ============================================================================
# 9. BUILD & TEMPORARY FILES
# ============================================================================

# Build outputs
dist/
build/
*.tar.gz
*.zip

# Temporary files
*.tmp
*.temp
*.bak
*.swp
*~

# ============================================================================
# 10. DEPENDENCIES & LOCK FILES (Optional - uncomment if needed)
# ============================================================================

# If you want to ignore lock files (not recommended for production)
# package-lock.json
# yarn.lock
# Pipfile.lock

# ============================================================================
# 11. SPECIAL DIRECTORIES (Uncomment as needed)
# ============================================================================

# Ignore entire directories
# /vendor/
# /tmp/
# /temp/

# ============================================================================
# 12. FILE PATTERNS (Uncomment as needed)
# ============================================================================

# Ignore all .log files
# *.log

# Ignore all .tmp files
# *.tmp

# ============================================================================
# NOTES
# ============================================================================
# - Keep lock files (package-lock.json, yarn.lock, Pipfile.lock) in git
#   for reproducible builds
# - Only add /.env if it contains no secrets
# - Use .env.example for template environment files
# - Consider .gitignore_global for personal IDE configs
# ============================================================================
