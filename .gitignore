# ==============================================================================
# The Open University (ou.ac.uk) Coursework .gitignore
# Computing & IT (Networking Focus)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Python & Jupyter Notebooks (TM112 & General Scripting)
# ------------------------------------------------------------------------------
# Virtual environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Byte-compiled / optimized files & cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/

# Jupyter Notebook checkpoints & runtime settings
# NOTE: *.ipynb files are tracked coursework; only ignore checkpoints and cache
.ipynb_checkpoints/
.jupyter/
.jupyterlab-settings/
ipython_config.py
profile_default/

# Python packaging & distribution (if building local packages)
build/
dist/
*.egg-info/
*.egg

# ------------------------------------------------------------------------------
# 2. Coursework & Office Documents (TMA submissions & reports)
# ------------------------------------------------------------------------------
# Microsoft Office lock/temporary files created when editing .docx/.xlsx/.pptx
~$*.doc*
~$*.xls*
~$*.ppt*

# LibreOffice lock files
.~lock.*#

# ------------------------------------------------------------------------------
# 3. Web Technologies & Node.js (TM252 & Web Lab Tools)
# ------------------------------------------------------------------------------
node_modules/
.npm/
.eslintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ------------------------------------------------------------------------------
# 4. Networking & Virtual Labs (TM129 & Networking Modules)
# ------------------------------------------------------------------------------
# VM runtime locks and memory dumps (VirtualBox / VMware)
*.vmem
*.vmsn
*.nvram
*.lck

# ------------------------------------------------------------------------------
# 5. Environment Variables & Secrets (API Keys, OpenCelliD, etc.)
# ------------------------------------------------------------------------------
.env
.env.local
.env.*.local
*.pem
*.key
credentials.json

# ------------------------------------------------------------------------------
# 6. Operating System Files
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Linux
*~
.directory

# ------------------------------------------------------------------------------
# 7. Editors & IDEs
# ------------------------------------------------------------------------------
# VS Code
.vscode/
*.code-workspace
.history/

# JetBrains (PyCharm, IntelliJ, WebStorm)
.idea/
*.iml
*.iws
*.ipr

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim / Emacs swap & backup files
*.swp
*.swo
*~
\#*\#
.\#*

# ------------------------------------------------------------------------------
# 8. Temporary & Backup Files
# ------------------------------------------------------------------------------
*.tmp
*.temp
*.bak
*.log
