# ============================================================================
# .gitignore - The Open University Coursework (ou.ac.uk)
# Modules: TM111, TM112, TM129, TM252, etc.
# ============================================================================

# ============================================================================
# 1. JUPYTER NOTEBOOKS
# ============================================================================
# Coursework notebook source files (*.ipynb) MUST be tracked by Git.
# Only ignore checkpoints, runtime configs, and local settings.
.ipynb_checkpoints/
*/.ipynb_checkpoints/*
*-checkpoint.ipynb
.jupyter/
.jupyterlab-settings/
.virtual_documents/

# IPython
profile_default/
ipython_config.py

# ============================================================================
# 2. PYTHON & VIRTUAL ENVIRONMENTS
# ============================================================================
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions / shared libraries
*.so
*.dylib
*.pyd

# Virtual environments (including versioned venvs)
.venv/
.venv*/
venv/
venv*/
env/
env*/
ENV/
env.bak/
venv.bak/
*.venv/

# Distribution / packaging
build/
dist/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
.Python

# PyInstaller / PyBuilder
*.manifest
*.spec
target/

# Installer & runtime logs
pip-log.txt
pip-delete-this-directory.txt
*.log

# Unit test, coverage & linting caches
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.ruff_cache/

# Python version managers & project settings
.python-version
.spyderproject
.spyproject
.ropeproject
__pypackages__/

# Celery & SageMath
celerybeat-schedule
celerybeat.pid
*.sage.py

# Web & documentation builds (Sphinx, MkDocs, Django, Flask)
docs/_build/
/site
instance/
.webassets-cache
.scrapy
local_settings.py
db.sqlite3
db.sqlite3-journal

# ============================================================================
# 3. NODE.JS & WEB (TM252 Web Technologies, etc.)
# ============================================================================
node_modules/
.npm
.eslintcache
.stylelintcache

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Modern Yarn
.yarn/cache
.yarn/unplugged/
.yarn/build-state.yml
.yarn/install-state.gz

# Note: Dependency lock files (package-lock.json, yarn.lock, pnpm-lock.yaml,
# Pipfile.lock, poetry.lock) are deliberately kept tracked for reproducible builds.

# ============================================================================
# 4. EDITORS & IDES
# ============================================================================
# Visual Studio Code
.vscode/
*.code-workspace
.history/

# JetBrains IDEs (PyCharm, WebStorm, etc.)
.idea/
.idea_modules/
*.iml
*.iws
*.ipr

# Cursor
.cursor/

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim / Neovim
*~
*.swp
*.swo
.vim/

# Emacs
\#*\#
.\#*

# ============================================================================
# 5. OPERATING SYSTEM & SYSTEM FILES
# ============================================================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
Icon
Icon?

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
.directory
.fuse_hidden*
.trashes
.nfs*

# ============================================================================
# 6. ENVIRONMENT VARIABLES & SECRETS
# ============================================================================
.env
.env.local
.env.*.local
*.env
!.env.example
!.env.template

# Secrets & credentials
.aws/
.ssh/
*.pem
*.key
*.cert
*.crt
credentials.json
.tokens

# ============================================================================
# 7. TEMPORARY & BACKUP FILES
# ============================================================================
*.tmp
*.temp
*.bak
*.backup
*.old
*.orig

# Microsoft Office temporary / autosave files (TMAs, reports, slides)
~$*.doc*
~$*.ppt*
~$*.xls*
